# Link boundary for ui/ (ADR 0010 §3.1): no ui target may link, directly or through
# another target, a target defined under runtimes/ or adapters/. Runs at the end of the
# top-level configure (cmake_language(DEFER)), once every directory has been added, and
# fails the configure on a violation.

function(mpt_ui_collect_links target out_var)
  set(_seen "")
  set(_queue "${target}")
  set(_bad "")
  while(_queue)
    list(POP_FRONT _queue _current)
    if(_current IN_LIST _seen)
      continue()
    endif()
    list(APPEND _seen "${_current}")
    if(NOT TARGET "${_current}")
      continue()
    endif()
    get_target_property(_aliased "${_current}" ALIASED_TARGET)
    if(_aliased)
      list(APPEND _queue "${_aliased}")
      continue()
    endif()
    get_target_property(_imported "${_current}" IMPORTED)
    if(NOT _imported)
      get_target_property(_dir "${_current}" SOURCE_DIR)
      file(RELATIVE_PATH _rel "${PROJECT_SOURCE_DIR}" "${_dir}")
      if(_rel MATCHES "^(runtimes|adapters)(/|$)")
        list(APPEND _bad "${_current} (${_rel})")
      endif()
    endif()
    set(_links "")
    foreach(_prop LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
      if(_imported AND _prop STREQUAL "LINK_LIBRARIES")
        continue()
      endif()
      get_target_property(_value "${_current}" ${_prop})
      if(_value)
        list(APPEND _links ${_value})
      endif()
    endforeach()
    foreach(_link IN LISTS _links)
      # $<LINK_ONLY:x> and similar wrappers: keep the target name.
      string(REGEX REPLACE "^\\$<[A-Z_]+:(.*)>$" "\\1" _link "${_link}")
      if(_link MATCHES "^\\$<|^-")
        continue()
      endif()
      list(APPEND _queue "${_link}")
    endforeach()
  endwhile()
  set(${out_var} "${_bad}" PARENT_SCOPE)
endfunction()

function(mpt_ui_check_link_boundary)
  set(_failures "")
  foreach(_target IN ITEMS mpt_ui mpt_ui_model mpt_ui_model_tests mpt_ui_overlay_tests)
    if(TARGET ${_target})
      mpt_ui_collect_links(${_target} _bad)
      foreach(_b IN LISTS _bad)
        list(APPEND _failures "${_target} links ${_b}")
      endforeach()
    endif()
  endforeach()
  if(_failures)
    list(JOIN _failures "\n  " _text)
    message(FATAL_ERROR "ui/ link boundary violated (ADR 0010 §3.1):\n  ${_text}")
  endif()
  message(STATUS "ui link boundary: OK")
endfunction()
