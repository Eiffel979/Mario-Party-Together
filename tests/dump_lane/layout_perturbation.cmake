# MP4 layout perturbation (dump lane, manual and local only; docs/titles/mp4.md section 20).
# A module built with the layout probe (MPT_MP4_RECIPE_LAYOUT_PROBE=ON or rodata) must give the same
# state_hash trail as a normal module on the same seeds and inputs: the Windows stand-in for the DLL and
# the .so laying the module out differently (E3c).
#
#   cmake -DPROBE_LANE=<probe build's mpt_dump_lane> -DREFERENCE_LANE=<normal build's mpt_dump_lane>
#         [-DSEEDS=1;2] [-DFRAMES=6000 | -DFULL=ON] [-DHASH_ITEMS_DIR=<dir>] -P layout_perturbation.cmake
#
# Each lane runs `--boot mp4 --party --seed S --every 10` (a trail line every 1,000 frames) in its own
# process. The trails, the exit codes and the final `dump lane: party ...` lines must match.
#  - Quick check (default): `--frames FRAMES` (6000), where both lanes stop before the party ends
#    (exit 1).
#  - FULL=ON, the gate of ADR 0008 ("Module words: a safe rule must not depend on layout", point 6):
#    the whole party, played to `finished`, and both lanes must exit 0.
#  - HASH_ITEMS_DIR: both lanes also run with `--hash-items <dir>/<lane>-seed<S>.txt`, which tallies
#    the canonical rules over every checkpoint; `count module_code_interior` must be 0 on both, and
#    `module_unknown` and `module_raw` are printed for review. The files name game symbols: keep the
#    directory outside the repository (the lane refuses one inside it).
# The reference lane must be a normal build and the probe lane a probe build (`--layout-probe`).
# Skipped without MPT_DUMP_DIR, or when a lane reports the skip code (77).
cmake_minimum_required(VERSION 3.25)

if(NOT DEFINED ENV{MPT_DUMP_DIR} OR "$ENV{MPT_DUMP_DIR}" STREQUAL "")
  message("SKIPPED: MPT_DUMP_DIR is not set")
  return()
endif()
foreach(_v PROBE_LANE REFERENCE_LANE)
  if(NOT DEFINED ${_v} OR NOT EXISTS "${${_v}}")
    message(FATAL_ERROR "layout perturbation: ${_v} is not an existing mpt_dump_lane")
  endif()
endforeach()
file(REAL_PATH "${PROBE_LANE}" _probe)
file(REAL_PATH "${REFERENCE_LANE}" _reference)
if(_probe STREQUAL _reference)
  message(FATAL_ERROR "layout perturbation: PROBE_LANE and REFERENCE_LANE are the same executable")
endif()
if(NOT DEFINED SEEDS)
  set(SEEDS 1)
endif()
if(NOT DEFINED FRAMES)
  set(FRAMES 6000)
endif()

# Each lane's layout probe mode: the reference must be OFF, the probe ON or rodata.
function(_probe_mode lane out)
  execute_process(COMMAND "${lane}" --layout-probe RESULT_VARIABLE _code OUTPUT_VARIABLE _out ERROR_VARIABLE _out)
  if(NOT _code EQUAL 0 OR NOT _out MATCHES "dump lane: layout probe ([A-Za-z]+)")
    message(FATAL_ERROR "layout perturbation: ${lane} does not report its layout probe mode (exit ${_code})")
  endif()
  set(${out} "${CMAKE_MATCH_1}" PARENT_SCOPE)
endfunction()
_probe_mode("${REFERENCE_LANE}" _ref_mode)
_probe_mode("${PROBE_LANE}" _prb_mode)
if(NOT _ref_mode STREQUAL "OFF")
  message(FATAL_ERROR "layout perturbation: the reference lane is a layout probe build (${_ref_mode}), not a normal one")
endif()
if(NOT _prb_mode STREQUAL "ON" AND NOT _prb_mode STREQUAL "rodata")
  message(FATAL_ERROR "layout perturbation: the probe lane is not a layout probe build (${_prb_mode})")
endif()
if(FULL)
  set(_length "the full party")
else()
  set(_length "${FRAMES} frames")
endif()
message("layout perturbation: probe ${_prb_mode} against OFF, ${_length}, seeds ${SEEDS}")

# One run: its `frame N hash X` lines, exit code, last `dump lane: party ...` line and hash-item counts.
function(_run lane name seed)
  set(_args --boot mp4 --party --seed ${seed} --every 10)
  if(NOT FULL)
    list(APPEND _args --frames ${FRAMES})
  endif()
  if(DEFINED HASH_ITEMS_DIR AND NOT HASH_ITEMS_DIR STREQUAL "")
    file(MAKE_DIRECTORY "${HASH_ITEMS_DIR}")
    list(APPEND _args --hash-items "${HASH_ITEMS_DIR}/${name}-seed${seed}.txt")
  endif()
  execute_process(COMMAND "${lane}" ${_args} RESULT_VARIABLE _code OUTPUT_VARIABLE _out ERROR_VARIABLE _out)
  string(REGEX MATCHALL "frame [0-9]+ hash [0-9a-f]+" _lines "${_out}")
  string(REGEX MATCHALL "dump lane: party [^\n]*" _ends "${_out}")
  set(_end "(none)")
  if(_ends)
    list(GET _ends -1 _end)
  endif()
  foreach(_rule module_code_interior module_unknown module_raw)
    set(_n "")
    if(_out MATCHES "dump lane: hash items count ${_rule} total ([0-9]+)")
      set(_n "${CMAKE_MATCH_1}")
    endif()
    set(${name}_${_rule} "${_n}" PARENT_SCOPE)
  endforeach()
  set(${name}_trail "${_lines}" PARENT_SCOPE)
  set(${name}_code "${_code}" PARENT_SCOPE)
  set(${name}_end "${_end}" PARENT_SCOPE)
endfunction()

set(_failed 0)
foreach(_seed IN LISTS SEEDS)
  _run("${REFERENCE_LANE}" ref ${_seed})
  if(ref_code EQUAL 77)
    message("SKIPPED: the reference lane skipped (exit 77): ${ref_end}")
    return()
  endif()
  _run("${PROBE_LANE}" prb ${_seed})
  if(prb_code EQUAL 77)
    message("SKIPPED: the probe lane skipped (exit 77): ${prb_end}")
    return()
  endif()
  list(LENGTH ref_trail _n)
  set(_why "")
  if(_n EQUAL 0)
    set(_why "the reference lane printed no trail (exit ${ref_code})")
  elseif(NOT ref_trail STREQUAL prb_trail)
    set(_first "")
    list(LENGTH prb_trail _m)
    math(EXPR _last "${_n} - 1")
    foreach(_i RANGE ${_last})
      list(GET ref_trail ${_i} _a)
      set(_b "(none)")
      if(_i LESS _m)
        list(GET prb_trail ${_i} _b)
      endif()
      if(NOT _a STREQUAL _b)
        set(_first "reference '${_a}', probe '${_b}'")
        break()
      endif()
    endforeach()
    if(_first STREQUAL "")
      set(_first "the probe trail is longer (${_m} against ${_n} checkpoints)")
    endif()
    set(_why "trails differ: ${_first}")
  elseif(NOT ref_code STREQUAL prb_code)
    set(_why "exit codes differ (${ref_code} vs ${prb_code})")
  elseif(NOT ref_end STREQUAL prb_end)
    set(_why "the runs end differently: reference '${ref_end}', probe '${prb_end}'")
  elseif(FULL AND NOT ref_code EQUAL 0)
    set(_why "the party did not finish (exit ${ref_code}): '${ref_end}'")
  endif()
  if(DEFINED HASH_ITEMS_DIR AND NOT HASH_ITEMS_DIR STREQUAL "")
    foreach(_lane ref prb)
      if(NOT _why STREQUAL "")
        # The first failure is the one reported; the counts below are printed in any case.
      elseif("${${_lane}_module_code_interior}" STREQUAL "")
        set(_why "the ${_lane} lane printed no hash-item counts")
      elseif(NOT ${_lane}_module_code_interior EQUAL 0)
        set(_why "the ${_lane} lane hashed ${${_lane}_module_code_interior} code-interior words raw (expected 0)")
      endif()
    endforeach()
    message("seed ${_seed}: hash items: module_code_interior ${ref_module_code_interior}/${prb_module_code_interior}, "
            "module_unknown ${ref_module_unknown}/${prb_module_unknown}, module_raw ${ref_module_raw}/${prb_module_raw} "
            "(reference/probe, summed over every checkpoint)")
  endif()
  if(_why STREQUAL "")
    list(GET ref_trail -1 _last_line)
    message("seed ${_seed}: ok, ${_n} checkpoints identical, last '${_last_line}', '${ref_end}' (exit ${ref_code})")
  else()
    message("seed ${_seed}: FAIL, ${_why}")
    set(_failed 1)
  endif()
endforeach()
if(_failed)
  message(FATAL_ERROR "layout perturbation: the state_hash trail depends on the module layout")
endif()
