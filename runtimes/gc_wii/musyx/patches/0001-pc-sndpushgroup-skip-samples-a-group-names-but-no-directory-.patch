 bool sndPushGroup(void* prj_data, u16 gid, void* samples, void* sdir, void* pool) {
   if (!sndActive || SP_CURRENT == 128 || !prj_data || !sdir)
     return false;
@@ -438,6 +446,13 @@ bool sndPushGroup(void* prj_data, u16 gid, void* samples, void* sdir, void* pool
     switch (record->type) {
     case 1:
       if (!dataAddSampleReference(record->id)) {
+        /* The console's ScanIDList skips a sample its group names but neither its own directory
