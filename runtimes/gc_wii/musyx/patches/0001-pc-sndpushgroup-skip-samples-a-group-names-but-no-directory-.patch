+/* Whether a native sample directory has an entry for `id`. */
+static bool pcDirectoryHas(const SDIR_DATA* sdir, u16 id) {
+  for (; sdir->id != 0xffff; ++sdir)
+    if (sdir->id == id)
+      return true;
+  return false;
+}
