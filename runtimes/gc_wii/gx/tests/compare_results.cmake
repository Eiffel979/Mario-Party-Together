# Compares two mpt_gx_scenes results.txt files column by column.
#   cmake -DA=<results.txt> -DB=<results.txt> -DCOLUMNS=gx,stream,bytes -P compare_results.cmake
# G-c (null against real): COLUMNS gx,stream,bytes. G-e (two real runs): COLUMNS img.
foreach(_v A B COLUMNS)
  if(NOT DEFINED ${_v})
    message(FATAL_ERROR "compare_results.cmake: -D${_v} is required")
  endif()
endforeach()
string(REPLACE "," ";" COLUMNS "${COLUMNS}")

function(_extract file out)
  file(STRINGS "${file}" _lines REGEX "^[a-z0-9_]+ frame=")
  set(_rows)
  foreach(_line IN LISTS _lines)
    string(REGEX MATCH "^([a-z0-9_]+) frame=([0-9]+)" _ "${_line}")
    set(_row "${CMAKE_MATCH_1}:${CMAKE_MATCH_2}")
    foreach(_c IN LISTS COLUMNS)
      string(REGEX MATCH " ${_c}=([0-9a-f]+)" _m "${_line}")
      if(NOT _m)
        message(FATAL_ERROR "${file}: no ${_c} column in: ${_line}")
      endif()
      string(APPEND _row " ${_c}=${CMAKE_MATCH_1}")
    endforeach()
    list(APPEND _rows "${_row}")
  endforeach()
  set(${out} "${_rows}" PARENT_SCOPE)
endfunction()

_extract("${A}" _a)
_extract("${B}" _b)
list(LENGTH _a _na)
list(LENGTH _b _nb)
if(_na EQUAL 0 OR NOT _na EQUAL _nb)
  message(FATAL_ERROR "different frame counts: ${_na} in ${A}, ${_nb} in ${B}")
endif()
set(_diff 0)
math(EXPR _last "${_na} - 1")
foreach(_i RANGE ${_last})
  list(GET _a ${_i} _ra)
  list(GET _b ${_i} _rb)
  if(NOT _ra STREQUAL _rb)
    message(STATUS "differs: ${_ra}  vs  ${_rb}")
    math(EXPR _diff "${_diff} + 1")
  endif()
endforeach()
if(_diff GREATER 0)
  message(FATAL_ERROR "${_diff} of ${_na} frames differ in ${COLUMNS}")
endif()
message(STATUS "${_na} frames identical in ${COLUMNS}")
