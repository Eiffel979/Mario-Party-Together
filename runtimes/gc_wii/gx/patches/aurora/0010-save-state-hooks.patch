+namespace aurora::gx {
+// Save-state access to the texture/TLUT object ID counters. The IDs live in game memory (GXTexObj,
+// GXTlutObj), so the counters are game state: they are saved and restored with it, never hashed.
+ObjIdCounters get_obj_id_counters() noexcept { return {sNextTexObjId, sNextTlutObjId}; }
+void set_obj_id_counters(const ObjIdCounters& counters) noexcept {
+  sNextTexObjId = counters.nextTexObjId;
+  sNextTlutObjId = counters.nextTlutObjId;
+}
+} // namespace aurora::gx
