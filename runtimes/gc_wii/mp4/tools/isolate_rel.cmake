# Symbol isolation and data bracketing for one REL (P1-15 required pieces 1 and 2).
#
# On the console each REL is a separate module linked by OSLink: its symbols are its own, and loading
# it again gives fresh .data. Here every REL is linked into the one game module, so:
# - every external symbol a REL defines is renamed to mpt_rel_<REL>__<symbol>, in all of the REL's
#   objects (definitions and the REL's own references). Two RELs can then define the same name, and a
#   REL never binds to a same-named symbol elsewhere. The DOL never references REL symbols except
#   ObjectSetup, which the generated overlay table reaches as mpt_rel_<REL>__ObjectSetup.
# - the REL's writable data lives in its own section range, so the loader can restore pristine .data
#   (and zero .bss: RELs are compiled with -fno-zero-initialized-in-bss) on every link. The section is
#   set when the REL is compiled (a forced-include header from runtimes/gc_wii/mp4/CMakeLists.txt):
#   COFF: .data$mptrel$<REL>$b, bracketed here by markers in $a and $c (the linker sorts by suffix);
#   ELF:  mptrel_<REL>, bracketed by __start_/__stop_mptrel_<REL>.
#
#   cmake -DREL=<name> -DFORMAT=coff|elf -DNM=<llvm-nm> -DOBJCOPY=<llvm-objcopy> -DAR=<llvm-ar>
#         "-DOBJECTS=<obj|obj|...>" -DOUT_LIB=<lib> -DOUT_INFO=<c file> -P isolate_rel.cmake
foreach(_v REL FORMAT NM OBJCOPY AR OBJECTS OUT_LIB OUT_INFO)
  if(NOT DEFINED ${_v} OR "${${_v}}" STREQUAL "")
    message(FATAL_ERROR "isolate_rel.cmake: -D${_v} is required")
  endif()
endforeach()
string(REPLACE "|" ";" OBJECTS "${OBJECTS}")  # the caller joins the object list with '|'
if(NOT REL MATCHES "^[A-Za-z0-9_]+$")
  message(FATAL_ERROR "isolate_rel.cmake: bad REL name '${REL}'")
endif()

get_filename_component(_work "${OUT_LIB}" DIRECTORY)
set(_work "${_work}/${REL}.iso")
file(REMOVE_RECURSE "${_work}")
file(MAKE_DIRECTORY "${_work}")

# 1. Every external symbol the REL defines.
set(_defined "")
foreach(_obj IN LISTS OBJECTS)
  execute_process(COMMAND "${NM}" --defined-only --extern-only --format=just-symbols "${_obj}"
                  OUTPUT_VARIABLE _out ERROR_VARIABLE _err RESULT_VARIABLE _rc)
  if(NOT _rc EQUAL 0)
    message(FATAL_ERROR "isolate_rel.cmake: ${NM} failed on ${_obj}: ${_err}")
  endif()
  string(REPLACE "\r" "" _out "${_out}")
  string(REPLACE "\n" ";" _syms "${_out}")
  foreach(_s IN LISTS _syms)
    string(STRIP "${_s}" _s)
    if(NOT _s STREQUAL "")
      list(APPEND _defined "${_s}")
    endif()
  endforeach()
endforeach()
list(REMOVE_DUPLICATES _defined)

set(_map "")
set(_has_setup FALSE)
foreach(_s IN LISTS _defined)
  string(APPEND _map "${_s} mpt_rel_${REL}__${_s}\n")
  if(_s STREQUAL "ObjectSetup")
    set(_has_setup TRUE)
  endif()
endforeach()
file(WRITE "${_work}/symbols.map" "${_map}")

# 2. Rename the symbols in every object. (The data section is already the REL's own: the REL is
#    compiled with a forced-include header that sets it, because llvm-objcopy cannot rename COFF
#    sections.)
set(_sect_args "")
set(_outs "")
set(_i 0)
foreach(_obj IN LISTS OBJECTS)
  get_filename_component(_name "${_obj}" NAME)
  set(_dst "${_work}/${_i}_${_name}")
  execute_process(COMMAND "${OBJCOPY}" "--redefine-syms=${_work}/symbols.map" ${_sect_args} "${_obj}" "${_dst}"
                  ERROR_VARIABLE _err RESULT_VARIABLE _rc)
  if(NOT _rc EQUAL 0)
    message(FATAL_ERROR "isolate_rel.cmake: ${OBJCOPY} failed on ${_obj}: ${_err}")
  endif()
  list(APPEND _outs "${_dst}")
  math(EXPR _i "${_i} + 1")
endforeach()

file(REMOVE "${OUT_LIB}")
execute_process(COMMAND "${AR}" rcs "${OUT_LIB}" ${_outs} ERROR_VARIABLE _err RESULT_VARIABLE _rc)
if(NOT _rc EQUAL 0)
  message(FATAL_ERROR "isolate_rel.cmake: ${AR} failed: ${_err}")
endif()

# 3. The REL's info record: its entry point and its data range.
set(_c "/* Generated by runtimes/gc_wii/mp4/tools/isolate_rel.cmake for ${REL}. Do not edit. */\n")
string(APPEND _c "#include \"mpt_mp4_rel.h\"\n")
if(_has_setup)
  string(APPEND _c "void mpt_rel_${REL}__ObjectSetup(void);\n")
  set(_setup "mpt_rel_${REL}__ObjectSetup")
else()
  set(_setup "0")
endif()
if(FORMAT STREQUAL "coff")
  string(APPEND _c "#pragma section(\".data$mptrel$${REL}$a\", read, write)\n")
  string(APPEND _c "#pragma section(\".data$mptrel$${REL}$c\", read, write)\n")
  string(APPEND _c "__declspec(allocate(\".data$mptrel$${REL}$a\")) static unsigned char mpt_start = 1;\n")
  string(APPEND _c "__declspec(allocate(\".data$mptrel$${REL}$c\")) static unsigned char mpt_stop = 1;\n")
  set(_lo "&mpt_start + 1")
  set(_hi "&mpt_stop")
else()
  string(APPEND _c "extern unsigned char __start_mptrel_${REL}[] __attribute__((weak, visibility(\"hidden\")));\n")
  string(APPEND _c "extern unsigned char __stop_mptrel_${REL}[] __attribute__((weak, visibility(\"hidden\")));\n")
  set(_lo "__start_mptrel_${REL}")
  set(_hi "__stop_mptrel_${REL}")
endif()
string(APPEND _c "const MptMp4RelInfo mpt_rel_info_${REL} = { \"${REL}\", ${_setup}, ${_lo}, ${_hi} };\n")
file(WRITE "${OUT_INFO}" "${_c}")
list(LENGTH _defined _nsym)
message(STATUS "${REL}: ${_nsym} symbols isolated, ObjectSetup ${_has_setup}")
