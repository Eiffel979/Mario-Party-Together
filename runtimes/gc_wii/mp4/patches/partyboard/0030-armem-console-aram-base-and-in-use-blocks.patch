+#ifdef MPT_PC
+/* runtimes/gc_wii/mp4 (ADR 0008, "Gate status after the implementation", finding 2): HuARMalloc's
+ * in-use blocks, in list order (which is address order), for the state hash and the ARAM alias check.
+ * Reads only. Writes at most max blocks and returns how many are in use, or -1 if the list does not
+ * end within ARMEM_BLOCK_MAX entries. */
+s32 mpt_mp4_armem_in_use(u32 *addr, u32 *size, s32 max) {
+    ARMEM_BLOCK *curr;
+    s32 n = 0;
+    s32 steps = 0;
+
+    for (curr = ARInfo; curr->next != 0; curr = curr->next) {
+        if (++steps > ARMEM_BLOCK_MAX) {
+            return -1;
+        }
+        if (curr->flag != 0) {
+            if (n < max) {
+                addr[n] = curr->aMemP;
+                size[n] = curr->size;
+            }
+            n++;
+        }
+    }
+    return n;
+}
+
+/* The lowest ARAM address HuARMalloc may hand out: msm's aramEnd (audio.c). */
+u32 mpt_mp4_armem_floor(void) {
+    return HU_AMEM_BASE;
+}
+#endif
